#!/bin/sh
# tmux-logs (alias tlogs): sessão tmux "logs" que mostra AO VIVO todas as instalações.
#   painel PC   = ssh <host>, /tmp/ff-install.log da distro ligada; reconecta sozinho após reboot/troca de distro
#                 host: $TLOGS_HOST, senão ~/.config/tlogs/host, senão "pc"
#   painel Void = este Void, /tmp/ff-install.log — SÓ aparece quando há instalação local (o log cresce);
#                 some sozinho após 3 min sem novidade
#   barra       = "term-hub status" do PC (CPU, RAM, SWP, /, rede, load, uptime), atualizada a cada 2 s
# Toda instalação feita pelo Claude anexa a saída nesses logs (cabeçalho "######## <distro>: <etapa> — <data> ########").
# Socket tmux próprio (-L tlogs): os atalhos abaixo não afetam outros tmux.
# Layouts (Ctrl+b, depois): 1 = só PC · 2 = só Void (se aberto) · h = lado a lado · v = empilhado (PC 70%) · = = metade/metade
#                           Tab = troca o painel ativo · d = sai sem fechar · q = fecha a sessão
T="tmux -L tlogs"
S=logs
ST=/tmp/tlogs-pc-status
H="${TLOGS_HOST:-$(cat "$HOME/.config/tlogs/host" 2>/dev/null)}"; H="${H:-pc}"
SSHO='-o ConnectTimeout=5 -o ServerAliveInterval=10 -o ServerAliveCountMax=3'
PC='while :; do
  ssh '"$SSHO"' '"$H"' \
    "printf \"\\033[1;36m==== PC: %s (%s) ====\\033[0m\\n\" \"\$(hostname)\" \"\$(date +%T)\"; touch /tmp/ff-install.log; tail -n 40 -F /tmp/ff-install.log" 2>/dev/null
  printf "\033[1;33m-- PC offline (reboot/troca de distro?); tentando de novo em 5 s --\033[0m\n"; sleep 5
done'
# barra do guest: uma conexão ssh fixa imprime "term-hub status" do PC a cada 2 s -> arquivo lido pelo status-right
STAT='while :; do
  ssh '"$SSHO"' '"$H"' \
    "h=\$(hostname); while :; do if [ -x ~/.local/bin/term-hub ]; then s=\$(~/.local/bin/term-hub status 2>/dev/null); else s=\"load \$(cut -d\" \" -f1 /proc/loadavg)\"; fi; printf \"%s|%s\\n\" \"\$h\" \"\$s\"; sleep 2; done" 2>/dev/null |
  while IFS="|" read -r h s; do printf "#[fg=#8caaee,bold]PC %s#[default] #[fg=#a5adce]%s" "$h" "$s" > '"$ST"'.tmp && mv '"$ST"'.tmp '"$ST"'; done
  printf "#[fg=#e5c890]PC offline" > '"$ST"'; sleep 5
done'
# vigia do Void: abre o painel local quando /tmp/ff-install.log cresce; fecha após 3 min parado
VIGIA='F=/tmp/ff-install.log; touch $F; last=$(stat -c %s $F); idle=0
while :; do sleep 2
  cur=$(stat -c %s $F 2>/dev/null || echo 0)
  loc=$(tmux -L tlogs list-panes -t logs:logs -F "#{pane_id} #{pane_title}" 2>/dev/null) || exit 0
  loc=$(echo "$loc" | awk "\$2==\"Void-local\"{print \$1; exit}")
  if [ "$cur" != "$last" ]; then last=$cur; idle=0
    [ -z "$loc" ] && { p=$(tmux -L tlogs split-window -d -P -F "#{pane_id}" -t logs:logs.0 -v -l 30% "tail -n 20 -F $F"); tmux -L tlogs select-pane -t "$p" -T Void-local; }
  else idle=$((idle+2))
    [ -n "$loc" ] && [ $idle -ge 180 ] && tmux -L tlogs kill-pane -t "$loc"
  fi
done'
# vigia do PC: cada trabalho em paralelo grava em /tmp/ff-install-<nome>.log no PC; abre um painel por arquivo
# ativo (mexido nos últimos 3 min) e fecha o painel quando o arquivo fica 3 min parado
VIGIAPC='while :; do sleep 4
  tmux -L tlogs has-session -t logs 2>/dev/null || exit 0
  ativos=$(ssh '"$SSHO"' '"$H"' "find /tmp -maxdepth 1 -name \"ff-install-*.log\" -mmin -3 2>/dev/null" 2>/dev/null) || continue
  for f in $ativos; do t="PC: ${f##*/}"
    tmux -L tlogs list-panes -t logs:logs -F "#{pane_title}" | grep -qxF "$t" && continue
    p=$(tmux -L tlogs split-window -d -P -F "#{pane_id}" -t logs:logs.0 -v -l 35% "ssh '"$SSHO"' '"$H"' \"tail -n 40 -F $f\"; sleep 2")
    tmux -L tlogs select-pane -t "$p" -T "$t"
    tmux -L tlogs select-layout -t logs:logs tiled
  done
  tmux -L tlogs list-panes -t logs:logs -F "#{pane_id} #{pane_title}" | while read -r id t; do
    case "$t" in "PC: ff-install-"*) echo "$ativos" | grep -qxF "/tmp/${t#PC: }" || tmux -L tlogs kill-pane -t "$id";; esac
  done
done'

if ! $T has-session -t "$S" 2>/dev/null; then
  $T -f /dev/null new-session -d -s "$S" -n logs -x 200 -y 50 "sh -c '$PC'"
  $T new-window -d -t "$S:" -n stat "sh -c '$STAT'"          # janela oculta que alimenta a barra
  $T new-window -d -t "$S:" -n vigia "sh -c '$VIGIA'"        # janela oculta: painel do Void só durante instalação local
  $T new-window -d -t "$S:" -n vigiapc "sh -c '$VIGIAPC'"    # janela oculta: um painel por /tmp/ff-install-<nome>.log ativo no PC
  $T set-option -g mouse on
  $T set-option -g history-limit 50000
  $T set-option -g pane-border-status top
  $T set-option -g allow-rename off
  $T set-option -g pane-border-format " #{?#{m:PC: ff-install-*,#{pane_title}},#{pane_title} (paralelo),#{?#{==:#{pane_title},Void-local},local $(hostname) (instalando) — /tmp/ff-install.log,remoto (ssh $H) — /tmp/ff-install.log}} "
  $T set-option -g pane-active-border-style 'fg=#8caaee'
  $T set-option -g status-interval 2
  $T set-option -g status-style 'bg=#292c3c,fg=#a5adce'
  $T set-option -g status-left-length 100
  # letras clicáveis: cada uma é um range; o clique vira "Ctrl+b <letra>" (send-keys -K na tabela prefix)
  $T set-option -g status-left '#[fg=#e5c890,bold] tlogs #[fg=#a5adce]Layouts: #[fg=#8caaee]#[range=user|z]z#[norange] · #[range=user|h]h#[norange] · #[range=user|v]v#[norange] · #[range=user|eq]=#[norange] · #[range=user|t]t#[norange] · #[range=user|T]T#[norange] · #[range=user|m]m#[norange] #[fg=#737994][#{@mode}] #[fg=#a6d189,bold]#[range=user|plus] + #[norange]#[fg=#e78284,bold]#[range=user|minus] - #[norange]#[fg=#737994,nobold]· #[range=user|help]? ajuda#[norange] #[default]'
  # clique: letras = Ctrl+b <letra>; + = novo painel (shell na pasta do painel ativo); - = fecha o painel ativo (o painel principal do PC, índice 0, não fecha)
  $T bind-key -n MouseDown1Status run-shell -b "k='#{mouse_status_range}'; case \$k in
      plus)  $T split-window -t '#{pane_id}' -c '#{pane_current_path}'; $T select-layout -t '#{window_id}' tiled; exit 0;;
      minus) [ '#{pane_index}' = 0 ] && { $T display-message -c '#{client_name}' 'o painel principal do PC não fecha'; exit 0; }; $T kill-pane -t '#{pane_id}'; exit 0;;
      eq) k='=';; help) k='?';; z|h|v|t|T|m) ;; *) exit 0;; esac
    $T switch-client -c '#{client_name}' -T prefix; $T send-keys -c '#{client_name}' -K \"\$k\""
  $T set-option -g status-right-length 200
  $T set-option -g status-right "#(cat $ST 2>/dev/null) "
  $T set-option -g window-status-format ''
  $T set-option -g window-status-current-format ''
  # layouts (prefixo Ctrl+b); @mode aparece na barra
  $T set-option -w -t "$S:logs" @mode Vertical
  $T bind-key z resize-pane -Z '\;' set-option -w @mode Zoom
  $T bind-key h select-layout -t "$S:logs" even-horizontal '\;' set-option -w -t "$S:logs" @mode Horizontal
  $T bind-key v select-layout -t "$S:logs" main-horizontal '\;' resize-pane -t "$S:logs.0" -y 70% '\;' set-option -w -t "$S:logs" @mode Vertical
  $T bind-key = select-layout -t "$S:logs" even-vertical '\;' set-option -w -t "$S:logs" @mode Metade
  $T bind-key T select-layout -t "$S:logs" tiled '\;' set-option -w -t "$S:logs" @mode Tiling
  $T bind-key m select-layout -t "$S:logs" main-vertical '\;' resize-pane -t "$S:logs.0" -x 65% '\;' set-option -w -t "$S:logs" @mode Vertical
  $T bind-key t if-shell -F '#{window_zoomed_flag}' 'refresh-client' 'resize-pane -Z' '\;' set-option -w @mode Tab
  $T bind-key Tab select-pane -Z -t :.+
  $T bind-key % split-window -h -c '#{pane_current_path}'     # nova pane ao lado (divide na vertical)
  $T bind-key '"' split-window -v -c '#{pane_current_path}'   # nova pane embaixo (divide na horizontal)
  $T bind-key q "kill-server"
  $T bind-key ? display-popup -w 90 -h 44 -T ' tlogs: atalhos ' -E "less -R -P'q fecha' $HOME/.local/bin/tmux-logs.ajuda"
  $T select-pane -t "$S:logs.0"
fi
if [ -n "$TMUX" ]; then exec env TMUX= $T attach -t "$S:logs"; else exec $T attach -t "$S:logs"; fi
