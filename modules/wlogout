#!/usr/bin/env bash
set -euo pipefail

target=auto
if (( $# > 1 )); then
  echo 'Uso: wlogout [--serpantinum|--niri|--hypr_lua|--hypr_conf]' >&2
  exit 2
fi

if (( $# == 1 )); then
  case "$1" in
    --serpantinum) target=serpantinum ;;
    --niri) target=niri ;;
    --hypr_lua) target=hypr_lua ;;
    --hypr_conf) target=hypr_conf ;;
    --help|-h)
      echo 'Uso: wlogout [--serpantinum|--niri|--hypr_lua|--hypr_conf]'
      exit 0
      ;;
    *)
      printf 'Opção desconhecida: %s\n' "$1" >&2
      echo 'Uso: wlogout [--serpantinum|--niri|--hypr_lua|--hypr_conf]' >&2
      exit 2
      ;;
  esac
fi

export WLOGOUT_SESSION_TARGET="$target"
exec "$HOME/.config/wlogout/launch.sh"
